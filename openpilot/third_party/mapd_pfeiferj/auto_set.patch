+package main
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestEvidenceBindsConsumedPosition(t *testing.T) {
+	pos := Position{Latitude: -23, Longitude: -46, Bearing: 90, LogMonoTime: 100000000000}
+	evidence := makeMapSpeedLimitEvidence(pos, true, 50.0/3.6)
+	pos.Latitude = -24
+	pos.LogMonoTime += 1000000000
+	if !evidence.Valid || evidence.Position.Latitude != -23 || evidence.Position.LogMonoTime != 100000000000 {
+		t.Fatal("result did not retain the consumed input", evidence)
+	}
+	data, err := json.Marshal(evidence)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded MapSpeedLimitEvidence
+	if err = json.Unmarshal(data, &decoded); err != nil || decoded != evidence {
+		t.Fatal("round trip", err)
+	}
+}
+
+func TestEvidenceInvalidInputs(t *testing.T) {
+	good := Position{Latitude: -23, Longitude: -46, Bearing: 90, LogMonoTime: 100000000000}
+	for _, limit := range []float64{0, -1, math.NaN(), math.Inf(1), 200.0 / 3.6} {
+		if makeMapSpeedLimitEvidence(good, true, limit).Valid {
+			t.Fatal("accepted bad limit", limit)
+		}
+	}
+	if makeMapSpeedLimitEvidence(good, false, 50.0/3.6).Valid {
+		t.Fatal("accepted failed matching")
+	}
+	good.LogMonoTime = 0
+	if makeMapSpeedLimitEvidence(good, true, 50.0/3.6).Valid {
+		t.Fatal("accepted missing input token")
+	}
+	good.LogMonoTime = 1
+	good.Latitude = 91
+	if makeMapSpeedLimitEvidence(good, true, 50.0/3.6).Valid {
+		t.Fatal("accepted invalid latitude")
+	}
+	good.Latitude = math.NaN()
+	invalid := makeMapSpeedLimitEvidence(good, true, 10)
+	if _, err := json.Marshal(invalid); err != nil {
+		t.Fatal("invalid evidence must be serializable", err)
+	}
+}
+
+func TestEvidenceAtomicReplacementAndInvalidation(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "proof")
+	valid := makeMapSpeedLimitEvidence(Position{Latitude: 1, Longitude: 2, LogMonoTime: 123}, true, 10)
+	for _, expected := range []MapSpeedLimitEvidence{valid, {}, valid} {
+		if err := writeMapSpeedLimitEvidence(path, expected); err != nil {
+			t.Fatal(err)
+		}
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var actual MapSpeedLimitEvidence
+		if err = json.Unmarshal(raw, &actual); err != nil || actual != expected {
+			t.Fatal("partial/wrong evidence", err, actual)
+		}
+	}
+	files, err := os.ReadDir(filepath.Dir(path))
+	if err != nil || len(files) != 1 {
+		t.Fatal("temporary file leak", err, files)
+	}
+}
+
+func TestEvidenceWriteFailure(t *testing.T) {
+	dir := t.TempDir()
+	if err := writeMapSpeedLimitEvidence(filepath.Join(dir, "missing", "proof"), MapSpeedLimitEvidence{}); err == nil {
+		t.Fatal("missing parent must report failure")
+	}
+}
+
+func TestEvidenceRepeatedInputDoesNotRenewToken(t *testing.T) {
+	pos := Position{Latitude: 1, Longitude: 2, Bearing: 0, LogMonoTime: 123456789}
+	first := makeMapSpeedLimitEvidence(pos, true, 10)
+	next := makeMapSpeedLimitEvidence(pos, true, 10)
+	if first != next {
+		t.Fatal("republication changed the evidence token")
+	}
+}
