+package main
+
+import (
+	"encoding/json"
+	"math"
+	"os"
+	"path/filepath"
+	"runtime"
+)
+
+// One atomic result binds the limit to the position actually consumed by mapd.
+// This is freshness/provenance evidence, not a claim that OSM is correct.
+type MapSpeedLimitEvidence struct {
+	Version    int      `json:"version"`
+	Valid      bool     `json:"valid"`
+	Position   Position `json:"position"`
+	SpeedLimit float64  `json:"speedLimit"`
+}
+
+func makeMapSpeedLimitEvidence(pos Position, matched bool, limit float64) MapSpeedLimitEvidence {
+	evidence := MapSpeedLimitEvidence{Version: 1}
+	finite := func(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+	if matched && pos.LogMonoTime > 0 && finite(pos.Latitude) && finite(pos.Longitude) && finite(pos.Bearing) &&
+		math.Abs(pos.Latitude) <= 90 && math.Abs(pos.Longitude) <= 180 && finite(limit) && limit > 0 && limit <= 145.0/3.6 {
+		evidence.Valid = true
+		evidence.Position = pos
+		evidence.SpeedLimit = limit
+	}
+	return evidence
+}
+
+func writeMapSpeedLimitEvidence(path string, evidence MapSpeedLimitEvidence) error {
+	data, err := json.Marshal(evidence)
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".map_speed_limit_evidence_")
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	_, err = file.Write(data)
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	if err = os.Rename(name, path); err != nil {
+		return err
+	}
+	// Windows is only used by the isolated test harness; directory fsync is Unix.
+	if runtime.GOOS == "windows" {
+		return nil
+	}
+	dir, err := os.Open(filepath.Dir(path))
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	return dir.Sync()
+}
